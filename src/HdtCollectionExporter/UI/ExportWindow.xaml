<Window x:Class="HdtCollectionExporter.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collection Exporter by Manacost"
        MinWidth="700"
        MinHeight="460"
        Width="780"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#202124"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F2F4F8" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#F2F4F8" />
            <Setter Property="Margin" Value="0,4,18,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#15171B" />
            <Setter Property="Foreground" Value="#F2F4F8" />
            <Setter Property="BorderBrush" Value="#6B7280" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#F2F4F8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2B2F36" />
            <Setter Property="Foreground" Value="#F2F4F8" />
            <Setter Property="BorderBrush" Value="#7C8490" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#373C45" />
                    <Setter Property="BorderBrush" Value="#A2AAB6" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#171A1F" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,18">
            <TextBlock x:Name="HeaderTitleTextBlock"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Text="Collection Exporter" />
            <TextBlock x:Name="BrandTextBlock"
                       Margin="0,4,0,0"
                       Foreground="#A9D36F"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="by Manacost" />
        </StackPanel>

        <TextBlock x:Name="OutputFolderLabel"
                   Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,6,12,12"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Output folder" />
        <TextBox x:Name="OutputFolderTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,0,10,12"
                 MinWidth="360"
                 VerticalAlignment="Center" />
        <Button x:Name="BrowseButton"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,0,12"
                MinWidth="96"
                Click="BrowseButton_OnClick"
                Content="Browse..." />

        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,14"
                Padding="14,12"
                Background="#181A1F"
                BorderBrush="#3E444E"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock x:Name="OptionsTitleTextBlock"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="Export options" />
                <WrapPanel>
                    <CheckBox x:Name="IncludeCardNamesCheckBox"
                              Content="include card names" />
                    <CheckBox x:Name="IncludeGoldenCountCheckBox"
                              Content="include golden count" />
                    <CheckBox x:Name="IncludeMetadataCheckBox"
                              Content="include metadata" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,14"
                    Orientation="Horizontal">
            <Button x:Name="ExportJsonButton"
                    MinWidth="128"
                    Margin="0,0,10,0"
                    Click="ExportJsonButton_OnClick"
                    Content="Export JSON" />
            <Button x:Name="ExportCsvButton"
                    MinWidth="128"
                    Margin="0,0,10,0"
                    Click="ExportCsvButton_OnClick"
                    Content="Export CSV" />
            <Button x:Name="ExportBothButton"
                    MinWidth="140"
                    Background="#6F2DBD"
                    BorderBrush="#B693E5"
                    Click="ExportBothButton_OnClick"
                    Content="Export Both" />
        </StackPanel>

        <Border Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Padding="14"
                Background="#15171B"
                BorderBrush="#5F6673"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock x:Name="StatusLabelTextBlock"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="Status" />
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,8,0,0"
                           Foreground="#F2F4F8"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="LastExportTextBlock"
                           Margin="0,10,0,0"
                           Foreground="#AEB4BC"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="PrivacyNoteTextBlock"
                   Grid.Row="5"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Margin="0,14,0,0"
                   Foreground="#AEB4BC"
                   TextWrapping="Wrap"
                   Text="Local export by Manacost. No collection data is sent to external services." />
    </Grid>
</Window>
