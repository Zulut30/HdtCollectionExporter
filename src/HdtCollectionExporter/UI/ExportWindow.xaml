<Window x:Class="HdtCollectionExporter.UI.ExportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Manacost · Collection" Width="940" Height="790" MinWidth="700" MinHeight="560"
 Background="#11151D" Foreground="#F2F1EC" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9AA6B7"/>
  <SolidColorBrush x:Key="Gold" Color="#E8BD71"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E9EDF4"/><Setter Property="Background" Value="#252E3E"/>
   <Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#3A4558" BorderThickness="1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E8BD71"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111722"/><Setter Property="Foreground" Value="#E9EDF4"/><Setter Property="BorderBrush" Value="#3A4558"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#71613C"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="#E9EDF4"/><Setter Property="Background" Value="#111722"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="#3A4558" BorderThickness="1" CornerRadius="8"/>
     <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" Foreground="#9AA6B7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3" FontSize="18"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,6,32,6"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Background="#202938" BorderBrush="#3A4558" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <ScrollViewer MaxHeight="320" Margin="4"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#E8BD71"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#71819A"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E9EDF4"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemChrome" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#35435A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#E8BD71"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D6DFEB"/><Setter Property="Margin" Value="0,6,0,6"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9AA6B7"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#E8BD71"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="#E8BD71"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#171E29"/><Setter Property="Foreground" Value="#DAE2ED"/><Setter Property="BorderBrush" Value="#303B4B"/><Setter Property="Padding" Value="5"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <DataTemplate x:Key="SummaryRow">
   <StackPanel Margin="0,2,0,6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Detail}" Foreground="#9AA6B7" FontSize="12" Margin="0,5,0,8"/>
    <ProgressBar Value="{Binding Completion, Mode=OneWay}" Maximum="100" Height="3" Foreground="#E8BD71" Background="#303B4B"/>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#1A2230"/><Setter Property="BorderBrush" Value="#2C384A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
 </Window.Resources>
 <Grid Margin="26,20,26,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="#E8BD71" CornerRadius="12" Width="52" Height="52" Margin="0,0,16,0"><TextBlock Text="M" Foreground="#181B23" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1"><TextBlock Text="MANACOST / COLLECTION" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Style="{StaticResource Label}" Margin="0,2,0,0"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="LanguageBox" Width="104" SelectionChanged="LanguageChanged" Margin="0,0,10,0"/><Button x:Name="RefreshButton" Click="RefreshClicked" Margin="0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,18">
   <StackPanel>
    <DockPanel Margin="0,0,0,18"><TextBlock x:Name="AccountText" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left"/><Border Background="#2A3343" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right"><TextBlock x:Name="ReadyText" FontSize="12" Foreground="{StaticResource Gold}"/></Border></DockPanel>
    <UniformGrid Columns="4">
     <StackPanel><TextBlock x:Name="UniqueLabel" Style="{StaticResource Label}"/><TextBlock x:Name="UniqueValue" Text="—" FontSize="28" FontWeight="SemiBold"/></StackPanel>
     <StackPanel><TextBlock x:Name="CopiesLabel" Style="{StaticResource Label}"/><TextBlock x:Name="CopiesValue" Text="—" FontSize="28" FontWeight="SemiBold"/></StackPanel>
     <StackPanel><TextBlock x:Name="PremiumLabel" Style="{StaticResource Label}"/><TextBlock x:Name="PremiumValue" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/></StackPanel>
     <StackPanel><TextBlock x:Name="DustLabel" Style="{StaticResource Label}"/><TextBlock x:Name="DustValue" Text="—" FontSize="28" FontWeight="SemiBold"/></StackPanel>
    </UniformGrid>
    <TextBlock x:Name="ReadTimeText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="2" x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,18,0,0">
   <TabItem x:Name="ExportTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ExportControls">
    <Border Style="{StaticResource Panel}"><StackPanel>
     <TextBlock x:Name="ExportHeading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0"><TextBlock x:Name="ModeLabel" Style="{StaticResource Label}"/><ComboBox x:Name="ModeBox" SelectionChanged="SelectionChanged"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock x:Name="FormatLabel" Style="{StaticResource Label}"/><ComboBox x:Name="FormatBox"/></StackPanel>
     </Grid>
     <TextBlock x:Name="PreviewText" Foreground="#D6DFEB" Margin="0,16,0,18"/>
     <TextBlock x:Name="FolderLabel" Style="{StaticResource Label}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputFolderTextBox"/><Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseClicked" Margin="10,0,0,0"/></Grid>
    </StackPanel></Border>
    <Expander x:Name="AdvancedExpander" Foreground="#AFBACB" Margin="0,16,0,8"><StackPanel Margin="4,12,0,0">
     <CheckBox x:Name="NamesCheck"/><CheckBox x:Name="PremiumCheck"/><CheckBox x:Name="MetadataCheck"/>
     <TextBlock x:Name="OptionsHint" Style="{StaticResource Label}" Margin="0,8,0,16"/>
     <WrapPanel><Button x:Name="SetBaselineButton" Click="SetBaselineClicked"/><Button x:Name="ImportButton" Click="ImportClicked"/><Button x:Name="ClearButton" Click="ClearClicked"/></WrapPanel>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="HistoryTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HistoryControls">
    <TextBlock x:Name="HistoryHint" Style="{StaticResource Label}"/>
    <ListBox x:Name="HistoryList" Height="130" Margin="0,0,0,16"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock x:Name="EarlierLabel" Style="{StaticResource Label}"/><ComboBox x:Name="EarlierBox"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock x:Name="LaterLabel" Style="{StaticResource Label}"/><ComboBox x:Name="LaterBox"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,16,0,0"><Button x:Name="CompareButton" Click="CompareClicked"/><Button x:Name="HistoryBaselineButton" Click="HistoryBaselineClicked"/><Button x:Name="HistoryFolderButton" Click="HistoryFolderClicked"/><Button x:Name="PruneButton" Click="PruneClicked" Margin="0,8,8,0"/></WrapPanel>
    <TextBlock x:Name="StorageText" Style="{StaticResource Label}" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="SummaryTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock x:Name="SummaryHint" Style="{StaticResource Label}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock x:Name="SetsLabel" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="SetsList" Height="245" ItemTemplate="{StaticResource SummaryRow}"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock x:Name="RaritiesLabel" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="RaritiesList" Height="245" ItemTemplate="{StaticResource SummaryRow}"/></StackPanel>
    </Grid>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#171E29" CornerRadius="10" Padding="16,12" Margin="0,18,0,0">
   <StackPanel><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#E8BD71" Background="#303B4B" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Foreground="#CCD6E4" VerticalAlignment="Center" MaxHeight="90" Margin="0,0,14,0"/>
     <StackPanel Grid.Column="1"><Button x:Name="ExportButton" Click="ExportClicked" Background="#E8BD71" Foreground="#171B24" FontWeight="SemiBold" FontSize="14" Padding="16,12" MinWidth="210" Margin="0" IsEnabled="False" IsDefault="True"/>
      <Button x:Name="CancelButton" Click="CancelClicked" Visibility="Collapsed" Padding="12,5" Margin="0,8,0,0"/></StackPanel>
    </Grid>
    <WrapPanel x:Name="ResultActions" Visibility="Collapsed" Margin="0,12,0,0"><Button x:Name="OpenFolderButton" Click="OpenFolderClicked" Padding="12,6"/><Button x:Name="ShowFileButton" Click="ShowFileClicked" Padding="12,6"/><Button x:Name="CopyPathButton" Click="CopyPathClicked" Padding="12,6"/></WrapPanel>
   </StackPanel>
  </Border>
 </Grid>
</Window>
